DATABASE_URL=sqlite:///./data/omnivoice.db
KAGGLE_USERNAME=
KAGGLE_KEY=
# Voicematics website accounts (optional; these are the defaults).
WEB_AUTH_DATABASE_URL=sqlite:///./data/web_users.db
# At least 32 characters. Leave empty to generate one in data/web_auth_jwt.key.
AUTH_JWT_SECRET=
# Language-model agents (website assistant, grammar compiler, clinical reports). Gemini is tried first;
# Groq takes over when a Gemini call fails. Leave both empty to disable the /api/agent endpoints.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
