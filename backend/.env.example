DATABASE_URL=sqlite:///./data/omnivoice.db
KAGGLE_USERNAME=
KAGGLE_KEY=
# true (the hosted service): app data, the caregiver relay and clinical reports need a signed-in account and
# plans are enforced. false: a single-user install where requests without a session get every feature.
REQUIRE_ACCOUNT=true
# Voicematics website accounts (optional; these are the defaults).
WEB_AUTH_DATABASE_URL=sqlite:///./data/web_users.db
# At least 32 characters. Leave empty to generate one in data/web_auth_jwt.key.
AUTH_JWT_SECRET=
# Language-model agents (website assistant, grammar compiler, clinical reports). Gemini is tried first;
# Groq takes over when a Gemini call fails. Leave both empty to disable the /api/agent endpoints.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# The sentence refiner tries this one when GEMINI_MODEL is overloaded; leave empty to go straight to Groq.
GEMINI_REFINE_FALLBACK_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
