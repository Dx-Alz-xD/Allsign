{
  "name": "frontend",
  "version": "1.0.1",
  "description": "Voicematics desktop app (Electron + Next.js 14)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit",
    "electron:compile": "tsc -p electron",
    "electron:dev": "npm run electron:compile && electron . --dev",
    "electron:start": "npm run build && npm run electron:compile && electron .",
    "prebuild": "node scripts/sync-worklets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "worklets:sync": "node scripts/sync-worklets.mjs",
    "worklets:check": "node scripts/sync-worklets.mjs --check",
    "electron:pack": "npm run build && npm run electron:compile && electron-builder --publish never",
    "electron:pack:win": "npm run build && npm run electron:compile && electron-builder --win --publish never"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "productName": "Voicematics",
  "author": "Voicematics",
  "build": {
    "appId": "app.voicematics.desktop",
    "productName": "Voicematics",
    "copyright": "Voicematics",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**",
      "out/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "out/**",
      "**/*.node"
    ],
    "artifactName": "${productName}-Setup.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Voicematics",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "publish": null
  }
}
